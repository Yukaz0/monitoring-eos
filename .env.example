# ============================================
# Konfigurasi stack monitoring SCADATR
# Salin file ini ke .env lalu isi nilainya.
# ============================================

# ---- monitoring-api ----
# Alamat REST API dipublikasikan (host:port). Port host 5118.
LISTEN_ADDR=:5118

# API key internal untuk endpoint mutasi REST (header X-API-Key).
# Wajib diisi. Pakai string acak yang panjang, mis. hasil `openssl rand -hex 32`.
API_KEY=ganti-dengan-api-key-acak

# DSN SQLite. Di container pakai path volume /data (sudah di-set Dockerfile).
# Untuk uji lokal, arahkan ke file biasa, mis. file:./monitoring.db
SQLITE_DSN=file:/data/monitoring.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)

# ---- collector / siklus laporan ----
# Base URL Prometheus di server SCADA (rocky-server).
PROMETHEUS_URL=http://192.168.3.204:9090

# Token portal SCADATR: string JSON mentah hasil scripts/extract_token.py.
# Alternatif: kosongkan dan set token via PUT /api/session/token (disimpan
# di SQLite). Isi token TIDAK boleh di-commit ke git.
SCADA_PORTAL_TOKEN=

# Path binary Chromium untuk chromedp (di container sudah di-set Dockerfile).
# Kosongkan untuk deteksi otomatis saat uji lokal.
CHROME_EXEC=

# Mode pembaca portal telemetri. "socket" = pembaca headless tanpa Chromium
# (socket.io polling + REST portal, hitungan detik bukan menit); "browser" =
# scraper chromedp lama (tidak dipakai lagi).
PORTAL_MODE=socket

# Host portal SCADATR. Di container domain ini dipetakan lewat extra_hosts
# docker-compose.yml (192.168.3.204).
PORTAL_HOST=scadatr.grita.id

# Port layanan portal: MQTT (socket.io) dan SYSTEM (REST master-rtu).
PORTAL_MQTT_PORT=14013
PORTAL_SYSTEM_PORT=14000

# Login REST portal otomatis (pengganti login manual di browser).
# Dipakai bila token di portal_session sudah mati/kedaluwarsa.
PORTAL_LOGIN_ENABLED=0
PORTAL_USERNAME=
PORTAL_PASSWORD=
# Hanya perlu bila akun tidak mfa_exempt: secret TOTP base32.
# Kalau akun otomasi belum mendaftarkan authenticator, login pertama
# mengembalikan manual_setup dan scripts/cek_login_portal.py --simpan-totp
# menyimpannya ke sini (nilainya tidak pernah dicetak).
PORTAL_TOTP_SECRET=
# Lama berhenti mencoba login otomatis setelah satu kegagalan (menit).
# Portal memblokir akun setelah beberapa kali login gagal, jadi siklus
# terjadwal harus berhenti mencoba. Default 360.
PORTAL_LOGIN_COOLDOWN_MINUTES=360

# Jendela pengumpulan event traffic maksimum per siklus pada PORTAL_MODE=socket
# (detik). RTU dianggap Active bila status broker Connected dan ada minimal
# satu event traffic (log-mqtt/datapoint-mqtt) untuk RTU itu di dalam jendela.
# Jendela ini menampung RTU yang jarang mengirim, mis. UPS yang hanya mengirim
# tiap beberapa menit.
PORTAL_LOG_WINDOW_SECONDS=600

# Jendela pengumpulan minimum (detik). Setelah jendela ini lewat, sweep
# berhenti lebih awal bila semua RTU yang broker-nya Connected sudah mengirim
# minimal satu event, sehingga laporan selesai cepat saat semua RTU aktif.
# RTU yang belum mengirim tetap ditunggu sampai PORTAL_LOG_WINDOW_SECONDS.
PORTAL_LOG_MIN_WINDOW_SECONDS=60

# Set 1 untuk melewati sweep portal (hanya metrik server; untuk uji lokal).
SKIP_PORTAL=0

# Set 1 untuk mematikan cron internal container: tidak ada laporan terjadwal
# yang dijalankan dari dalam container (baris tabel schedules di SQLite tetap
# ada untuk UI). Penjadwalan laporan dijalankan dari host, karena sweep portal
# SCADATR (Chromium headful) tidak stabil di dalam container; sekarang sweep
# portal dijalankan headless (PORTAL_MODE=socket) sehingga cron container aman.
# Trigger manual POST /api/report/run tetap berfungsi.
DISABLE_INTERNAL_SCHEDULER=0

# 1 = izinkan pengiriman laporan walau bagian telemetri RTU gagal dibaca.
# Default 0: laporan setengah jadi ditahan (hanya disimpan ke riwayat).
# Hanya dinyalakan sementara saat operator sadar sesi portal sedang diperbarui.
SEND_WITHOUT_TELEMETRY=0

# ---- whatsapp-service ----
# API key whatsapp-service. Wajib diisi (dipakai api dan service itu sendiri).
WA_API_KEY=ganti-dengan-api-key-wa-acak

# Base URL whatsapp-service dari sudut pandang monitoring-api.
# Di stack compose cukup nama service; dari host pakai http://localhost:3101.
WA_BASE_URL=http://whatsapp-service:3101

# Port whatsapp-service (di-set ulang di compose).
WA_SERVICE_PORT=3101

# Direktori sesi Baileys di dalam container whatsapp-service.
WA_AUTH_DIR=/data/baileys-session
